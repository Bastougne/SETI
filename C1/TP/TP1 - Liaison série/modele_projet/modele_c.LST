  68   2                      FLAG_Timer = 0;
  69   2              }
  70   1              
  71   1              if(j==10&& way==0)
  72   1                      j=0;
  73   1              else if(j==0 && way==1)
  74   1                      j=10;
  75   1              return j;
  76   1      }
