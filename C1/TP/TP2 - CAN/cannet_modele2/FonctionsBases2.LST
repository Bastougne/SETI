 209   2        //ATTENTION ne pas faire ca car cela risque de planter
 210   2        // il faut rien faire dans ce cas et prévenir qu'il n'y  pas 
 211   2        //d'émission...... et emettre à nouveau apres.
 212   2          CANCON           = TRANSMIT_ABORT|DIFFERENTIAL;     /*    not possible            */
 213   2          can_system_error = TRUE;
 214   2          can_init_request = TRUE;
 215   2          can_partner      = FALSE;
 216   2          can_tx_ready=can_tx_sending=FALSE;
 217   2              return 0;
 218   2          };
 219   1      }
