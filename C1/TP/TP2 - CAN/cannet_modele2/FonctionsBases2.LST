 190          unsigned char send_message ( unsigned char *tabtx ){
 191   1      
 192   1        int_save    = CANCON;
 193   1        if  ( CAN_TX_BUFFER )   {
 194   2          CANSTA = (char)tabtx;
 195   2          CANADR = DMA_EN|AUTO_TX_BUFFER;
 196   2              _nop_();
 197   2              _nop_();
 198   2              _nop_();
 199   2              _nop_();
 200   2              _nop_();
 201   2          can_event = TRUE;
 202   2          can_tx_ready = FALSE;
 203   2          can_tx_sending = TRUE; 
 204   2          CANCON = TRANSMIT_REQUEST|DIFFERENTIAL;                     /* start CAN transmit to SLIO */
 205   2              return 1;
 206   2        }
 207   1        else   {                                                      /* error exit, if transmit    */
